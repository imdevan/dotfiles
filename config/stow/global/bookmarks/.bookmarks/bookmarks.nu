# Generated by bookmark manager
# Do not edit manually - changes will be overwritten

# Function wrapper to auto-source bookmarks after running bookmark commands
# This ensures new/updated bookmarks are immediately available in your shell
def --wrapped bookmark [...args] {
	^bookmark ...$args
}

# Interactive bookmark navigation function
# Displays the TUI and executes the selected bookmark command
# Note: Nushell interactive wrapper
def bm [] {
	with-env {CLICOLOR_FORCE: "1"} {
		let cmd = (bookmark -i)
		if ($cmd | is-not-empty) {
			let parts = ($cmd | split row ';')
			for part in $parts {
				let trimmed = ($part | str trim)
				if ($trimmed | str starts-with "cd ") {
					let path = ($trimmed | str replace "cd " "" | str trim | str replace -r "^['\"]" "" | str replace -r "['\"]$" "")
					cd $path
				} else {
					nu -c $trimmed
				}
			}
		}
	}
}

# BM: fi|/home/devy/Projects/bookmark||2026-06-25T09:20:39-07:00|2026-06-25T09:20:39-07:00||||
alias fi = cd '/home/devy/Projects/bookmark'

# BM: pla|/home/devy/Projects/playground||2026-06-25T09:26:42-07:00|2026-06-25T09:26:42-07:00|play|||
alias pla = cd '/home/devy/Projects/playground'; tmux rename-window 'play'

# BM: pro|/home/devy/Projects||2026-06-25T09:33:42-07:00|2026-06-25T09:33:49-07:00|pro|||
alias pro = cd '/home/devy/Projects'; tmux rename-window 'pro'

