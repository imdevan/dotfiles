# Generated by alias manager
# Do not edit manually - changes will be overwritten

# Function wrapper to auto-source aliases after running alias commands
# This ensures new/updated aliases are immediately available in your shell
aliases() {
	if [ $# -eq 0 ]; then
		local cmd=$(CLICOLOR_FORCE=1 command aliases -i)
		if [[ -n "$cmd" ]]; then
			eval "$cmd"
		fi
	else
		command aliases "$@"
	fi
	source /home/devy/.aliases/aliases.zsh
}

# Interactive alias navigation function
# Delegates to consolidated aliases function
al() {
	aliases "$@"
}

